# ─── Local (localhost) ───────────────────────────────────────────────────────
# Métadonnées médias → PostgreSQL ; fichiers → dossier /media (pas de Supabase).
# Ne pas définir les variables S3_* en local.

DATABASE_URI=postgresql://cinemergence:cinemergence@localhost:5433/cinemergence
PAYLOAD_SECRET=change-me-min-32-characters-long
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : forcer le mode (auto = local en dev, supabase en prod)
# MEDIA_STORAGE=local

# ─── Production (Vercel uniquement) ──────────────────────────────────────────
# Supabase Storage → Dashboard → Storage → S3 Connection → Access keys
# Bucket public requis : cinemergence-media

# S3_BUCKET=cinemergence-media
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/cinemergence-media
# MIGRATE_MEDIA_SECRET=random-secret-for-seed-migrate-storage

# ─── Authentification (Clerk) ────────────────────────────────────────────────
# Dashboard → clerk.com → créer une application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Intégrations ────────────────────────────────────────────────────────────

# Brevo (newsletter + notifications formulaire contact)
# xsmtpsib-… = clé SMTP (relai smtp-relay.brevo.com) | xkeysib-… = clé API REST v3
BREVO_API_KEY=
BREVO_LIST_ID=
# Login SMTP Brevo — obligatoire si BREVO_API_KEY commence par xsmtpsib-
# Brevo → SMTP & API → onglet SMTP → « Login SMTP » (format xxx@smtp-brevo.com)
BREVO_SMTP_LOGIN=
# Expéditeur déjà déclaré dans Brevo (Expéditeurs). Ne pas mettre contact@cinemergence.fr :
# Brevo refuse un From qui n'est pas vérifié, et bloque l'envoi.
BREVO_SENDER_EMAIL=verdat.sylvain@gmail.com
BREVO_SENDER_NAME=Cinémergence

# Google Analytics est chargé par Tag Manager (GTM-KF4DTPJH), plus par le site.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Clé du serveur de mesure Addingwell. Jamais dans le navigateur.
CINEMERGENCE_MEASUREMENT_KEY=

# Signature du webhook Stripe : checkout.session.completed et checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Vercel Cron envoie Authorization: Bearer <CRON_SECRET> à /api/measurement/retry
CRON_SECRET=

# Contact form notifications (destinataire des formulaires contact/inscription/financement)
CONTACT_NOTIFICATION_EMAIL=contact@cinemergence.fr

# Compte Stripe qui encaisse la masterclass Kheiron (pas STRIPE_SECRET_KEY).
# La clé doit pouvoir créer des Checkout Sessions (écriture) et les relire.
# Une clé restreinte en lecture seule laisse le bouton retomber sur le lien de paiement.
STRIPE_KHEIRON_SECRET_KEY=
