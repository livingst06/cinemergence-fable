# ─── Shared ──────────────────────────────────────────────────────────────────
# BDD : localhost + Preview = même DATABASE_URI (dev).
# Prod (cinemergence.vercel.app) : plus tard une BDD dédiée (pas encore créée) —
# voir .cursor/rules/vercel-env-vars.mdc checklist go-live.
# Médias : bucket Supabase partagé pour l’instant.

DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/postgres
PAYLOAD_SECRET=change-me-min-32-characters-long
NEXT_PUBLIC_SITE_URL=http://localhost:3000

MEDIA_STORAGE=supabase
S3_BUCKET=cinemergence-media
S3_REGION=eu-central-1
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/cinemergence-media
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/cinemergence-media

# Opt-out disque local uniquement (hors sync) : MEDIA_STORAGE=local

# ─── Authentification (Clerk) ────────────────────────────────────────────────
# Dashboard → clerk.com → créer une application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Whitelists rôles (emails séparés par des virgules) — source de vérité au login
# ADMIN_LIST=tom.mccallaghan@gmail.com
# FORMATEUR_LIST=
# INTERVENANT_LIST=

# ─── Intégrations ────────────────────────────────────────────────────────────

# Brevo (newsletter + notifications formulaire contact)
# xsmtpsib-… = clé SMTP (relai smtp-relay.brevo.com) | xkeysib-… = clé API REST v3
BREVO_API_KEY=
BREVO_LIST_ID=
# Login SMTP Brevo — obligatoire si BREVO_API_KEY commence par xsmtpsib-
# Brevo → SMTP & API → onglet SMTP → « Login SMTP » (format xxx@smtp-brevo.com)
BREVO_SMTP_LOGIN=
# Expéditeur vérifié dans Brevo (souvent la même adresse que le destinataire au début)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cinémergence

# Google Analytics (loaded after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form notifications (destinataire des formulaires contact/inscription/financement)
CONTACT_NOTIFICATION_EMAIL=verdat.sylvain@gmail.com

# ─── Stripe (paiement places formation) ──────────────────────────────────────
# Dashboard → Developers → API keys + Webhooks
# Phase actuelle : Preview + Production Vercel = même compte Stripe TEST.
# Plus tard : Preview → test ; Production → live (clés + webhook séparés).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local : secret affiché par `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Preview/Prod : secret de l’endpoint Dashboard correspondant (un secret ≠ par env Vercel)
#   Prod    → https://cinemergence.vercel.app/api/stripe/webhook
#   Preview → URL de branche …/api/stripe/webhook
# Events : checkout.session.completed, checkout.session.expired,
#          checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
