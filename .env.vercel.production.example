# Copy to .env.vercel.production (gitignored) then run: ./scripts/sync-vercel-env.sh
# Do NOT commit this file with real secrets.

# BDD : aujourd’hui souvent la même que Preview. Go-live : DATABASE_URI Production
# doit pointer vers une BDD prod dédiée (à créer) — localhost/Preview restent sur la BDD dev.
DATABASE_URI=
PAYLOAD_SECRET=
# Scope Vercel :
# - Production → https://cinemergence.vercel.app (puis https://cinemergence.fr avec le DNS)
# - Preview    → https://cinemergence-git-feat-v2-admin-session-livingst06s-projects.vercel.app
#   (URL de branche fixe ; une entrée Preview séparée dans le dashboard / CLI)
NEXT_PUBLIC_SITE_URL=https://cinemergence.vercel.app

S3_BUCKET=cinemergence-media
S3_REGION=eu-central-1
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/cinemergence-media
# Exposé au front pour les covers statiques (même valeur publique)
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/cinemergence-media
MIGRATE_MEDIA_SECRET=

BREVO_API_KEY=
BREVO_LIST_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
CONTACT_NOTIFICATION_EMAIL=cinemergence.paris@gmail.com

# Whitelist admins (emails séparés par des virgules)
# ADMIN_LIST=tom.mccallaghan@gmail.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
