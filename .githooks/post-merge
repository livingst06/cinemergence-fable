#!/bin/sh
# Après un git pull sur main : retire les branches locales dont GitHub a
# supprimé le remote (PR squashée). Ne touche pas à main.
git fetch --prune origin >/dev/null 2>&1 || true

branches=$(
  git branch -vv | awk '/: gone]/ { if ($1 == "*") print $2; else print $1 }' \
    | grep -vx -E 'main|master' || true
)

if [ -z "$branches" ]; then
  exit 0
fi

printf '%s\n' "$branches" | while read -r branch; do
  [ -n "$branch" ] || continue
  git branch -D "$branch"
done
